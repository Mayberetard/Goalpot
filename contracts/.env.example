# REQUIRED — deployer key. Export from a NEW throwaway wallet
# (MetaMask -> account details -> show private key), then fund that
# wallet at https://faucet.monad.xyz. Never commit the real .env file.
PRIVATE_KEY=

# OPTIONAL — RPC override. Leave empty to use the public
# https://testnet-rpc.monad.xyz endpoint.
MONAD_RPC_URL=
