# REQUIRED — copy from the output of `npm run deploy:testnet`
# (the line "GoalPot deployed at: 0x...").
VITE_FACTORY_ADDRESS=

# OPTIONAL — "testnet" (default) or "mainnet".
VITE_MONAD_NETWORK=testnet

# OPTIONAL — RPC override (e.g. a local hardhat node or private endpoint).
# Leave empty to use the chain's public RPC.
VITE_RPC_URL=

# OPTIONAL but recommended for mobile — WalletConnect project id.
# Create one free at https://cloud.reown.com; enables the "any mobile
# wallet" QR/deep-link option. Without it, mobile users are offered
# MetaMask/Phantom in-app-browser links instead.
VITE_WC_PROJECT_ID=
